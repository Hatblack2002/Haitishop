rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isApprovedSeller() {
      return signedIn() &&
        exists(/databases/$(database)/documents/sellerApplications/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sellerApplications/$(request.auth.uid)).data.status == 'approved';
    }
    match /products/{productId} {
      allow read: if true;
      allow create: if isApprovedSeller() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if signedIn() &&
        (resource.data.sellerId == request.auth.uid || isAdmin());
    }
    match /sellerApplications/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending';
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /sellerProfiles/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
