rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isVerifiedSeller() {
      return signedIn() &&
        exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'verificado';
    }
    match /products/{productId} {
      allow read: if true;
      allow create: if isVerifiedSeller() && request.resource.data.sellerId == request.auth.uid;
      // El vendedor puede editar lo suyo PERO sin tocar los sellos KYC
      // (sellerVerified / active los controla el servidor tras suspensiones).
      allow update, delete: if isAdmin() || (signedIn() &&
        resource.data.sellerId == request.auth.uid &&
        resource.data.sellerVerified == request.resource.data.sellerVerified &&
        resource.data.active == request.resource.data.active);
    }
    // Expediente KYC: se escribe SOLO en el servidor (API routes con Admin SDK).
    match /sellers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
    // Perfil público para la insignia "Vendeur vérifié" (el servidor lo escribe).
    match /sellerProfiles/{uid} {
      allow read: if true;
      allow write: if false;
    }
    // Flujo antiguo de solicitudes (legado, lectura).
    match /sellerApplications/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending';
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    // Escrow: los pedidos se crean y transicionan SOLO en el servidor (API routes
    // con Admin SDK). El cliente solo lee sus propios pedidos.
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }
    // Tokens de un solo uso (solo hash en la BD): inaccesibles desde el cliente.
    match /escrowTokens/{tokenHash} {
      allow read, write: if false;
    }
    // Historial y litigos: lectura solo admin; escritura solo servidor.
    match /orderEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /disputes/{disputeId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // ─── KYC: colecciones privadas (nada accesible desde el cliente) ───
    match /kycPhoneCodes/{id} { allow read, write: if false; }
    match /kycRateLimits/{id} { allow read, write: if false; }
    match /kycFiles/{fileId} { allow read, write: if false; }
    match /kycFiles/{fileId}/chunks/{chunkId} { allow read, write: if false; }
    match /kycAccessLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /kycAudit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
