# --- Seed del catálogo (scripts/seed-firestore.mjs) ---
# Ruta local a la clave de cuenta de servicio (nunca versionar el archivo).
# Uso: FIREBASE_SERVICE_ACCOUNT_PATH=./clave.json npm run seed
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Escrow / servidor (API routes en Vercel) --------------------------------
# Valores que salen del JSON de la cuenta de servicio (NUNCA versionar el JSON).
FIREBASE_PROJECT_ID=haitishop
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# E-mails transaccionales (Resend, gratis: resend.com). Sin clave, los correos
# se registran en el log del servidor y en el historial, y nada se rompe.
RESEND_API_KEY=
EMAIL_FROM=HaïtiShop <onboarding@resend.dev>
# Correo del administrador (recibe avisos de confirmaciones, litigos y pagos).
ADMIN_EMAIL=vertiljivenson9@gmail.com

# Comisión de la plataforma en % (5 por defecto).
ESCROW_COMMISSION_PERCENT=5
# Clave opcional para cifrar el código de entrega visible por el cliente
# (si se omite se deriva de FIREBASE_PRIVATE_KEY).
ESCROW_ENC_KEY=
# Secreto del cron de Vercel (transiciones 24 h / 72 h).
CRON_SECRET=
# URL pública (opcional; se deduce de la petición si se omite).
NEXT_PUBLIC_SITE_URL=

# --- KYC de vendedores -------------------------------------------------------
# Vercel AI Gateway (clave vck_...) para el pre-chequeo IA opcional de documentos.
AI_GATEWAY_API_KEY=
AI_GATEWAY_VISION_MODEL=google/gemini-2.5-flash
# Documentos KYC: se guardan CIFRADOS (AES-256-GCM) en trozos dentro de
# Firestore privado y solo se sirven por enlaces firmados HMAC con caducidad
# de 10 minutos via API admin. No se usa Cloudinary publico ni buckets GCS.
# Códigos de verificación por WhatsApp Business Cloud API (Meta): plantilla de
# categoría AUTHENTICATION con botón "copiar código", aprobada en Meta Business
# Manager en fr, ht y en. Credenciales SOLO por variables de entorno (nunca en
# el repo ni en los logs).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# (variante antigua aceptada: WHATSAPP_PHONE_NUMBER_ID)
# Idioma de la plantilla: fr (defecto), ht o en.
WHATSAPP_LANG=fr
# Nombre de la plantilla Authentication (defecto: haitishop_code).
WHATSAPP_TEMPLATE_NAME=haitishop_code
# Modo desarrollo: SOLO se activa fuera de producción (NODE_ENV != production).
# Devuelve el código en la respuesta para probar el flujo en local; en
# producción se ignora aunque esté en true.
KYC_SMS_DEV_MODE=false
